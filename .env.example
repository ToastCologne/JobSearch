# AI Provider — set the key that matches ai.provider in config.yaml

# provider: gemini  → FREE tier at https://aistudio.google.com (recommended)
GEMINI_API_KEY=your_gemini_key_here

# provider: anthropic → paid, get key at https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_key_here

# provider: ollama → no key needed; install Ollama from https://ollama.ai
